PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/hopeandheal
JWT_SECRET=replace-with-a-long-random-string
CLIENT_URL=http://localhost:5173

# First staff/admin account (run: npm run seed:admin)
ADMIN_NAME=Center Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123

# Optional SMTP for password-reset emails.
# If SMTP_HOST is empty, the reset link is printed in the server console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Hope and Heal Recovery Center <no-reply@yourdomain.com>"
